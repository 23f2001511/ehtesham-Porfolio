# ==============================================================================
# Portfolio Environment Variables
# ==============================================================================

# Database: MongoDB Atlas (Optional in dev, Recommended for Production)
# If left empty, local JSON storage is used at data/portfolio-store.json.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio"

# Authentication: Secret key for signing admin session cookies (32+ characters)
SESSION_SECRET="replace-with-a-random-secret-key-at-least-32-chars-long"

# Initial Admin Credentials (used for first-time login)
ADMIN_EMAIL="alamehtesham88@gmail.com"
ADMIN_PASSWORD="your-secure-password"

# ==============================================================================
# Email Notification Configuration (For Contact Form & Password Reset OTP)
# ==============================================================================
# Option 1: Gmail SMTP (Recommended)
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="alamehtesham88@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"

# Email recipient for visitor contact messages (defaults to alamehtesham88@gmail.com)
CONTACT_RECIPIENT_EMAIL="alamehtesham88@gmail.com"

# Option 2: Resend API (Alternative to SMTP)
# RESEND_API_KEY="re_123456789"

# Optional: GitHub Personal Access Token (raises rate limit for live GitHub stats)
# GITHUB_TOKEN="ghp_xxxxxxxxxxxx"
